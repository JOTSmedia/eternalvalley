# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files with LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rules text eol=lf
*.command text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary media assets (prevent Git from corrupting or attempting line-ending diffs)
*.mp4 binary
*.webm binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.hdr binary
*.glb binary
*.gltf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.ogg binary
